{
  "name": "@nufi/dapp-client-cardano",
  "version": "0.7.1",
  "license": "MIT",
  "homepage": "https://github.com/nufi-official/dapp-client/tree/master/cardano",
  "repository": {
    "type": "git",
    "url": "git://github.com/nufi-official/dapp-client.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index",
  "files": [
    "src",
    "!src/__tests__",
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/**/*.ts.map",
    "!dist/**/*.cts.map"
  ],
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup --onSuccess 'yarn build:declarationMap'",
    "watch": "tsup --watch --onSuccess 'yarn build:declarationMap'",
    "build:declarationMap": "tsc --emitDeclarationOnly --declarationMap",
    "test:tsc": "tsc --noEmit",
    "test": "yarn test:tsc",
    "prepublish": "yarn test",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@nufi/dapp-client-core": "workspace:*"
  },
  "devDependencies": {
    "esbuild-plugin-file-path-extensions": "^2.1.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "yarn@4.10.3"
}
